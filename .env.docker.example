# Copier en .env.docker puis renseigner les valeurs vides.
# Ce fichier est lu par les conteneurs app et db (docker-compose.yml).
# Ne jamais commiter .env.docker : il contient des secrets.

# --- Ports publiés sur l'hôte ---------------------------------------------
APP_PORT=8088
PHPMYADMIN_PORT=8081

# Le SPA et l'API partagent la même origine : chemin relatif.
VITE_API_URL=/api/v1

# --- MySQL (conteneur db) --------------------------------------------------
MYSQL_DATABASE=patiserie
MYSQL_USER=patiserie
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --- Laravel (conteneur app) ----------------------------------------------
APP_NAME=PatiserieChoukran
APP_ENV=production
# php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8088

APP_TIMEZONE=Africa/Douala
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# Doit correspondre aux variables MYSQL_* ci-dessus.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=patiserie
DB_USERNAME=patiserie
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
CACHE_STORE=database

# Traitée par le worker intégré à l'image.
QUEUE_CONNECTION=database

# L'API n'accepte que des jetons Bearer : même origine, donc pas de CORS.
# À renseigner uniquement si le SPA est servi depuis un autre domaine.
CORS_ALLOWED_ORIGINS=

MAIL_MAILER=log
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SCHEME=smtp
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"
